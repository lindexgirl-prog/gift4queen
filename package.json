{
  "name": "family-memory-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run build:preview",
    "build:preview": "npm run typecheck && vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "build:release": "npm run build",
    "build:pages": "npm run build:release && node scripts/prepare-github-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:node": "node --test tests/validate-content.test.mjs tests/sites-worker.test.mjs tests/github-pages.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "5.0.4",
    "motion": "^13.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
